Options -Indexes -MultiViews
DirectoryIndex index.html

# Custom 404 page (prerendered)
ErrorDocument 404 /404.html

# ---------- Clean URLs: /nxpay -> nxpay/index.html (no redirect) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (remove these two lines if SSL is not set up yet)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove trailing slash: /nxpay/ -> /nxpay (sitemap uses no slash)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Serve folder/index.html for clean URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# Stop Apache from redirecting /nxpay to /nxpay/ (we rewrite instead)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Correct types ----------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

# ---------- Caching ----------
<IfModule mod_headers.c>
  # Hashed build files never change -> cache for 1 year
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images / icons -> 30 days
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML always revalidated so new deploys show immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>